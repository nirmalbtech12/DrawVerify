@page
@model RunsIndexModel
@{
    ViewData["Title"] = "Pipeline Runs";
}
<h1>Pipeline Runs</h1>
<form method="get" class="row g-2 mb-3">
  <div class="col"><input name="q" value="@Model.Q" placeholder="Jira ID (KAN-19)" class="form-control" /></div>
  <div class="col"><input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" /></div>
  <div class="col"><input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" /></div>
  <div class="col">
    <select asp-for="Status" class="form-select">
      <option value="">All Status</option>
      @foreach(var s in Enum.GetNames(typeof(Models.PipelineRunStatus))) {
        <option value="@s">@s</option>
      }
    </select>
  </div>
  <div class="col">
    <select asp-for="PageSize" class="form-select" onchange="this.form.submit()">
      <option value="5">5</option>
      <option value="10">10</option>
      <option value="20">20</option>
      <option value="50">50</option>
      <option value="100">100</option>
    </select>
  </div>
  <div class="col"><button class="btn btn-primary">Search</button></div>
</form>
<table class="table table-sm">
<thead><tr><th>Run ID</th><th>Jira ID</th><th>Schedule</th><th>Status</th><th>Agents</th><th>Current</th><th>Started</th><th>Duration</th><th>Actions</th></tr></thead>
<tbody>
@foreach(var r in Model.Runs){
<tr>
<td><a href="/Pipeline/Runs/@r.RunId">@r.RunId</a></td>
<td>@r.JiraId</td>
<td>@r.ScheduleType @r.ScheduledAt?.ToLocalTime().ToString("g")</td>
<td>@r.Status</td>
<td>@(r.SelectedAgentsJson ?? "")</td>
<td>@r.CurrentAgent</td>
<td>@r.StartedAt?.ToLocalTime().ToString("g")</td>
<td>@(r.DurationSeconds?.ToString("0s") ?? "-")</td>
<td><a href="/Pipeline/Runs/@r.RunId">View</a></td>
</tr>
}
</tbody>
</table>
<nav aria-label="Runs pagination">
  <ul class="pagination pagination-sm justify-content-center">
    @if (Model.HasPrevious) {
      <li class="page-item"><a class="page-link" href="?q=@Model.Q&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")&status=@Model.Status&page=1&pageSize=@Model.PageSize">First</a></li>
      <li class="page-item"><a class="page-link" href="?q=@Model.Q&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")&status=@Model.Status&page=@(Model.CurrentPage-1)&pageSize=@Model.PageSize">Prev</a></li>
    } else {
      <li class="page-item disabled"><span class="page-link">First</span></li>
      <li class="page-item disabled"><span class="page-link">Prev</span></li>
    }
    @{
      int startPage = Math.Max(1, Model.CurrentPage - 2);
      int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
      if (Model.TotalPages > 5) {
        if (Model.CurrentPage <= 3) endPage = 5;
        else if (Model.CurrentPage >= Model.TotalPages - 2) startPage = Model.TotalPages - 4;
      }
    }
    @for (int p = startPage; p <= endPage; p++) {
      if (p == Model.CurrentPage) {
        <li class="page-item active"><span class="page-link">@p</span></li>
      } else {
        <li class="page-item"><a class="page-link" href="?q=@Model.Q&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")&status=@Model.Status&page=@p&pageSize=@Model.PageSize">@p</a></li>
      }
    }
    @if (Model.HasNext) {
      <li class="page-item"><a class="page-link" href="?q=@Model.Q&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")&status=@Model.Status&page=@(Model.CurrentPage+1)&pageSize=@Model.PageSize">Next</a></li>
      <li class="page-item"><a class="page-link" href="?q=@Model.Q&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")&status=@Model.Status&page=@Model.TotalPages&pageSize=@Model.PageSize">Last</a></li>
    } else {
      <li class="page-item disabled"><span class="page-link">Next</span></li>
      <li class="page-item disabled"><span class="page-link">Last</span></li>
    }
  </ul>
</nav>
<div class="text-center text-muted small mt-2">
  Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total)
</div>