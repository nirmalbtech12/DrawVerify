@page "/Pipeline/Runs/{runId}"
@model DetailModel
@{
    ViewData["Title"] = "Run " + Model.Run?.RunId;
}
@if(Model.Run==null){<p>Not found</p> return;}
<h1>@Model.Run.RunId <small class="text-muted">@Model.Run.JiraId</small></h1>
<div class="row">
  <div class="col-md-6">
    <dl>
      <dt>Schedule</dt><dd>@Model.Run.ScheduleType @Model.Run.ScheduledAt?.ToLocalTime()</dd>
      <dt>Status</dt><dd><span id="runStatus" class="badge bg-primary">@Model.Run.Status</span></dd>
      <dt>Branch</dt><dd>@Model.Run.BranchName</dd>
      <dt>Commit</dt><dd>@Model.Run.CommitHash</dd>
      <dt>PR</dt><dd>@if(Model.Run.PullRequestUrl!=null){<a href="@Model.Run.PullRequestUrl">#@Model.Run.PullRequestNumber</a>}</dd>
      <dt>Created</dt><dd>@Model.Run.CreatedAt.ToLocalTime()</dd>
      <dt>Duration</dt><dd id="runDuration">@(Model.Run.DurationSeconds?.ToString("0s") ?? "-")</dd>
    </dl>
  </div>
  <div class="col-md-6">
    <h5>Pipeline Progress</h5>
    <ol id="progress">
    @foreach(var a in Model.Run.Agents.OrderBy(x=>x.ExecutionOrder)){
      var icon = a.Status==Models.AgentStatus.Completed ? "✓" : a.Status==Models.AgentStatus.Running ? "▶" : a.Status==Models.AgentStatus.Failed ? "✗" : a.Status==Models.AgentStatus.WaitingForApproval ? "⏸" : "○";
      var hasArtifact = Model.AvailableArtifacts.TryGetValue(a.AgentId, out var artifactFile);
      <li><span class="agent-status" data-agent="@a.AgentId">@icon @a.AgentName — @a.Status</span> <small>@a.StartedAt?.ToLocalTime().ToString("T") @a.DurationSeconds?.ToString("0s")</small>
        @if(hasArtifact){
          <a asp-page="" asp-page-handler="Artifact" asp-route-runId="@Model.Run.RunId" asp-route-agentId="@a.AgentId" target="_blank" class="ms-2 small text-decoration-underline" title="View generated file .pipeline/state/@Model.Run.JiraId/@artifactFile">View @artifactFile</a>
        }
        @if(a.Status==Models.AgentStatus.WaitingForApproval){
          <form method="post" asp-page-handler="Approve" asp-route-runId="@Model.Run.RunId" class="d-inline ms-2">
            <button type="submit" name="decision" value="APPROVED" class="btn btn-sm btn-success">Approve</button>
            <button type="submit" name="decision" value="REJECTED" class="btn btn-sm btn-danger">Reject</button>
          </form>
        }
      </li>
    }
    </ol>
    @if(Model.Run.Status==Models.PipelineRunStatus.WaitingForApproval){
      <div class="alert alert-warning">Waiting for human approval — approve above to continue.</div>
    }
    <h6>Skipped / Not Selected</h6>
    <p>@string.Join(", ", Model.NotSelected)</p>
  </div>
</div>

<h5>Detailed Logs <small id="elapsed"></small></h5>
<div class="mb-2">
  <button class="btn btn-sm btn-outline-secondary" onclick="filterLogs('all')">All</button>
  <button class="btn btn-sm btn-outline-secondary" onclick="filterLogs('Error')">Errors</button>
  <button class="btn btn-sm btn-outline-secondary" onclick="filterLogs('Warn')">Warnings</button>
</div>
<table class="table table-sm" id="logs">
<thead><tr><th>Time</th><th>Level</th><th>Agent</th><th>Message</th></tr></thead>
<tbody>
@foreach(var l in Model.Logs){
<tr data-level="@l.Level"><td>@l.Timestamp.ToLocalTime().ToString("T")</td><td>@l.Level</td><td>@l.Agent</td><td>@l.Message</td></tr>
}
</tbody>
</table>

@section Scripts{
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
  const runId = "@Model.Run.RunId";
  const conn = new signalR.HubConnectionBuilder().withUrl("/hubs/pipeline").build();
  conn.on("Log", m => {
    const tbody = document.querySelector("#logs tbody");
    const tr = document.createElement("tr");
    tr.dataset.level = m.level;
    tr.innerHTML = `<td>${new Date(m.at).toLocaleTimeString()}</td><td>${m.level}</td><td>${m.stage}</td><td>${m.message}</td>`;
    tbody.appendChild(tr);
  });
  conn.on("RunUpdate", m => {
    document.getElementById("runStatus").textContent = m.status;
  });
  conn.start().then(()=>conn.invoke("JoinRun", runId));
  function filterLogs(f){ document.querySelectorAll("#logs tbody tr").forEach(tr=>{ tr.style.display = f==='all' || tr.dataset.level===f ? '' : 'none'; }); }
  // Fallback polling
  setInterval(()=>fetch(window.location.href).then(r=>r.text()).then(html=>{/* simple reload for MVP */}), 5000);
</script>
}
