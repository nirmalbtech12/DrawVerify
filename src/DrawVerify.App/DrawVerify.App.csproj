<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DrawVerify.App</RootNamespace>
    <AssemblyName>DrawVerify.App</AssemblyName>
    <ApplicationIcon>..\..\branding\DrawVerify.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrawVerify.Application\DrawVerify.Application.csproj" />
    <ProjectReference Include="..\DrawVerify.Core\DrawVerify.Core.csproj" />
    <ProjectReference Include="..\DrawVerify.Geometry\DrawVerify.Geometry.csproj" />
    <ProjectReference Include="..\DrawVerify.OcctService\DrawVerify.OcctService.csproj" />
    <ProjectReference Include="..\DrawVerify.Infrastructure\DrawVerify.Infrastructure.csproj" />
    <ProjectReference Include="..\DrawVerify.OcctWorker\DrawVerify.OcctWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../config/workflow.default.json" Link="config/workflow.default.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\gdt-subset.default.json" Link="config\gdt-subset.default.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\fingerprint-policy.default.json" Link="config\fingerprint-policy.default.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="..\..\LICENSE.txt" Link="LICENSE.txt" />
    <None Include="..\..\docs\lgpl-compliance.md" Link="docs\lgpl-compliance.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\branding\**" Link="branding\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
