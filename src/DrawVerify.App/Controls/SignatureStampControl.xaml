<UserControl x:Class="DrawVerify.App.Controls.SignatureStampControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="DarkGray" BorderThickness="1" Padding="12" Margin="4">
        <StackPanel>
            <TextBlock Text="Maker Signature" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="Your signature attests that this submission is complete, legally binding, and tamper-evident." TextWrapping="Wrap" Margin="0,6,0,8" />
            <TextBlock Text="Type your name, draw with a pointer/stylus, or upload a signature image." TextWrapping="Wrap" />
            <TextBox x:Name="TypedName" Margin="0,8,0,0" ToolTip="Typed signature" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Preview" Click="Preview_Click" Margin="0,0,8,0" />
                <Button Content="Cancel / Re-enter" Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="PreviewText" Visibility="Collapsed" Margin="0,8,0,0" />
            <TextBlock Text="Maker signature is required before submission." Foreground="DarkRed" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
