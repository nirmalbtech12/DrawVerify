<UserControl x:Class="DrawVerify.App.Controls.SignatureStampControl" x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
    <Border BorderBrush="DarkGray" BorderThickness="1" Padding="12" Margin="4" Visibility="{Binding IsSignatureVisible, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
            <TextBlock Text="{Binding SignatureLabel, ElementName=root}" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="This attests that your submission is complete. Signatures are legally binding and tamper-evident." TextWrapping="Wrap" Margin="0,6,0,8" />
            <TextBlock Text="Use a typed name, drawing, or signature image. Preview before finalizing." TextWrapping="Wrap" />
            <TextBox Text="{Binding DraftName, ElementName=root, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit, ElementName=root}" ToolTip="Typed signature" Margin="0,8,0,0" />
            <TextBox Text="{Binding Title, ElementName=root, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit, ElementName=root}" ToolTip="Optional title" Margin="0,4,0,0" />
            <TextBox Text="{Binding Department, ElementName=root, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit, ElementName=root}" ToolTip="Optional department" Margin="0,4,0,0" />
            <InkCanvas x:Name="DrawingSurface" Height="70" Background="White" Margin="0,6" IsEnabled="{Binding CanEdit, ElementName=root}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Preview typed" Click="PreviewTyped_Click" IsEnabled="{Binding CanEdit, ElementName=root}" Margin="0,0,6,0" />
                <Button Content="Preview drawing" Click="PreviewDrawing_Click" IsEnabled="{Binding CanEdit, ElementName=root}" Margin="0,0,6,0" />
                <Button Content="Upload image" Click="Upload_Click" IsEnabled="{Binding CanEdit, ElementName=root}" Margin="0,0,6,0" />
                <Button Content="Finalize signature" Click="Finalize_Click" IsEnabled="{Binding CanEdit, ElementName=root}" />
            </StackPanel>
            <TextBlock Text="{Binding PreviewText, ElementName=root}" Visibility="{Binding HasPreview, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Button Content="Cancel / Re-enter" Click="CancelPreview_Click" IsEnabled="{Binding CanEdit, ElementName=root}" Visibility="{Binding HasPreview, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Left" Margin="0,4,0,0" />
            <StackPanel Visibility="{Binding IsFinalized, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Signature finalized and locked." FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding MetadataText, ElementName=root}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorText, ElementName=root}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
