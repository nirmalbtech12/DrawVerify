<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- DrawVerify brand tokens: change these resources to rebrand the product. -->
  <SolidColorBrush x:Key="ShellBackground" Color="#FF090B0D"/><SolidColorBrush x:Key="SurfaceBackground" Color="#FF121619"/><SolidColorBrush x:Key="SurfaceRaisedBackground" Color="#FF1A2024"/><SolidColorBrush x:Key="StatusBackground" Color="#FF101416"/><SolidColorBrush x:Key="BrandGreen" Color="#FF35D07F"/><SolidColorBrush x:Key="BrandGreenDark" Color="#FF168653"/><SolidColorBrush x:Key="BrandWhite" Color="#FFF4F7F5"/><SolidColorBrush x:Key="BrandMuted" Color="#FFAAB7B0"/><SolidColorBrush x:Key="BrandBorder" Color="#FF2B3832"/><SolidColorBrush x:Key="BrandError" Color="#FFFF7B7B"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="#FF2A3832"/>
    <Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrandGreen}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonSurface" Property="Background" Value="#FF52645D"/>
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#FF71827A"/>
              <Setter Property="Foreground" Value="#FFD5DED9"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource BrandGreenDark}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandGreen}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#FF27332F"/><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandGreen}"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/></Trigger><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#FF27332F"/><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandGreen}"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/><Setter Property="Padding" Value="6"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{DynamicResource BrandGreen}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="Margin" Value="2"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource BrandMuted}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ProgressBar"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandGreen}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/><Setter Property="RowBackground" Value="{DynamicResource SurfaceBackground}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceRaisedBackground}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF24352D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGreenDark}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource BrandGreenDark}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/><Setter Property="Padding" Value="6,4"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF24352D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGreenDark}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="Padding" Value="8,5"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF24352D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGreenDark}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="Menu"><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="Padding" Value="8,4"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/><Setter Property="Padding" Value="10,7"/></Style>
</ResourceDictionary>
