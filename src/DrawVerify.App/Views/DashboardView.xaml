<UserControl x:Class="DrawVerify.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Welcome to DrawVerify" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Quick usage guide" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrandGreen}" Margin="0,18,0,8"/>
            <ItemsControl ItemsSource="{Binding UsageGuide}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceRaisedBackground}" BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding RoleName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrandGreen}"/>
                                <TextBlock Text="{Binding RoleDescription}" Foreground="{DynamicResource BrandMuted}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="• " Foreground="{DynamicResource BrandGreen}"/>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource BrandWhite}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No role-specific usage guide is available for this account." Foreground="{DynamicResource BrandMuted}" TextWrapping="Wrap" Visibility="{Binding HasNoUsageGuide, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
