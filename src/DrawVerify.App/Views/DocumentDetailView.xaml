<UserControl x:Class="DrawVerify.App.Views.DocumentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:DrawVerify.Core.Enums;assembly=DrawVerify.Core">
    <StackPanel Margin="24">
        <TextBlock Text="Document details" FontSize="24"/>
        <TextBlock Text="{Binding OriginalFileName}"/>
        <TextBlock Text="{Binding FileSizeBytes, StringFormat=Size: {0} bytes}"/>
        <TextBlock Text="{Binding UploadTimestampUtc}"/>
        <TextBlock Text="{Binding UploaderUserId, StringFormat=Uploader: {0}}"/>
        <TextBlock Text="{Binding UploaderDisplayName, StringFormat=Uploader name: {0}}"/>
        <TextBlock Text="{Binding DocumentType}"/>
        <TextBlock Text="{Binding UploadStatus}"/>
        <TextBlock Text="{Binding VerificationStatusDisplay, StringFormat=Verification: {0}}"/>
        <TextBlock Text="{Binding VerificationError, StringFormat=Verification error: {0}}"/>
        <TextBlock Text="{Binding GeometryStatus}"/>
        <TextBlock Text="{Binding CurrentVersion, StringFormat=Version: {0}}"/>
        <TextBlock Text="{Binding FingerprintDisplay, StringFormat=Fingerprint: {0}}" TextWrapping="Wrap"/>
        <Button Content="Verify Fingerprint" Command="{Binding VerifyFingerprintCommand}" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding FingerprintVerificationMessage}" TextWrapping="Wrap"/>
        <TextBlock Text="Fingerprint guidance: a fingerprint is a SHA-256 value calculated from the submitted files and metadata. Verify recomputes it and compares both values. Match means unchanged; Mismatch may indicate alteration; Error means verification could not complete." TextWrapping="Wrap" Margin="0,4,0,12"/>
        <TextBlock Text="{Binding SubmittedFingerprintDisplay, StringFormat=Stored fingerprint: {0}}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SubmittedFingerprintAlgorithm, StringFormat=Fingerprint algorithm: {0}}"/>
        <TextBlock Text="{Binding SubmittedFingerprintCanonicalizationVersion, StringFormat=Canonicalization version: {0}}"/>
        <TextBlock Text="{Binding FingerprintVerification.Computed.Value, StringFormat=Recomputed fingerprint: {0}}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding FingerprintVerification.VerifiedUtc, StringFormat=Verified: {0}}"/>
        <TextBlock Text="{Binding FingerprintVerification.VerifierDisplayName, StringFormat=Verifier: {0}}"/>
        <TextBlock Text="{Binding SubmittedTimestampUtc, StringFormat=Submitted: {0}}"/>
        <TextBlock Text="{Binding SubmittedMakerDisplayName, StringFormat=Submitted by Maker: {0}}"/>
        <StackPanel Orientation="Horizontal" Visibility="{Binding CanEscalateFingerprintMismatch, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,12">
            <Button Content="Flag for investigation" Command="{Binding FlagFingerprintMismatchCommand}" Margin="0,0,8,0"/>
            <Button Content="Reject for integrity issue" Command="{Binding RejectFingerprintMismatchCommand}" Margin="0,0,8,0"/>
            <Button Content="Return for integrity investigation" Command="{Binding ReturnFingerprintMismatchCommand}"/>
        </StackPanel>
        <Button Content="Extract Dimensions" Command="{Binding ExtractDimensionsCommand}" Margin="0,16,0,8"/>
        <Button Content="Refresh Dimensions" Command="{Binding LoadDimensionsCommand}" Margin="0,0,0,8"/>
        <Button Content="Submit for Review" Command="{Binding SubmitForReviewCommand}" Margin="0,0,0,8"/>
        <TextBlock Text="Prior versions" FontWeight="Bold" Margin="0,16,0,8"/>
        <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding PriorMakerFilter, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,8" ToolTip="Maker filter"/>
            <ComboBox SelectedValue="{Binding PriorStatusFilter, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Width="170" Margin="0,0,8,8" ToolTip="Workflow status filter">
                <ComboBoxItem Tag="{x:Null}" IsSelected="True">All statuses</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static enums:WorkflowStatus.Draft}">Draft</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static enums:WorkflowStatus.SubmittedForReview}">Submitted for review</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static enums:WorkflowStatus.UnderReview}">Under review</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static enums:WorkflowStatus.Rejected}">Rejected</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static enums:WorkflowStatus.Approved}">Approved</ComboBoxItem>
            </ComboBox>
            <DatePicker SelectedDate="{Binding PriorFromUtc}" Width="130" Margin="0,0,8,8" ToolTip="From UTC"/>
            <DatePicker SelectedDate="{Binding PriorToUtc}" Width="130" Margin="0,0,8,8" ToolTip="To UTC"/>
            <Button Content="Load history" Command="{Binding LoadPriorVersionsCommand}" Margin="0,0,8,8"/>
            <Button Content="View current version" Command="{Binding ViewCurrentVersionCommand}" Margin="0,0,8,8"/>
            <Button Content="Compare with current" Command="{Binding ComparePriorVersionCommand}" Margin="0,0,8,8"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding PriorVersions}" SelectedItem="{Binding SelectedPriorVersion}" DisplayMemberPath="Revision" SelectionChanged="PriorVersionSelectionChanged"/>
        <StackPanel DataContext="{Binding SelectedPriorVersion}" Margin="0,8,0,8">
            <TextBlock Text="{Binding Revision, StringFormat=Revision: {0}}"/>
            <TextBlock Text="{Binding SubmissionId, StringFormat=Submission: {0}}"/>
            <TextBlock Text="{Binding MakerDisplayName, StringFormat=Maker: {0}}"/>
            <TextBlock Text="{Binding Status, StringFormat=Status: {0}}"/>
            <TextBlock Text="{Binding CreatedUtc, StringFormat=Created: {0}}"/>
            <TextBlock Text="{Binding SubmittedUtc, StringFormat=Submitted: {0}}"/>
            <TextBlock Text="{Binding ApprovedUtc, StringFormat=Approved: {0}}"/>
            <TextBlock Text="{Binding StepDocumentVersionId, StringFormat=STEP version: {0}}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DxfDocumentVersionId, StringFormat=DXF version: {0}}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Package.Fingerprint.Value, StringFormat=Fingerprint: {0}}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                <Button Content="Open STEP read-only" Command="{Binding DataContext.OpenHistoricalStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,8,0"/>
                <Button Content="Open DXF read-only" Command="{Binding DataContext.OpenHistoricalDxfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>
            <TextBlock Text="{Binding RejectionReason, StringFormat=Rejection: {0}}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CorrectionResponse, StringFormat=Correction response: {0}}" TextWrapping="Wrap"/>
            <TextBlock Text="Prior versions are read-only." FontStyle="Italic"/>
            <TextBlock Text="Review comments" FontWeight="Bold" Margin="0,8,0,2"/>
            <ItemsControl ItemsSource="{Binding Comments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text, StringFormat=Comment: {0}}" ToolTip="{Binding Location}" TextWrapping="Wrap" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Verification results" FontWeight="Bold" Margin="0,8,0,2"/>
            <TextBlock Text="{Binding Package.VerificationFindings.Count, StringFormat=Verification findings: {0}}"/>
            <ItemsControl ItemsSource="{Binding Package.VerificationFindings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BrandBorder}" BorderThickness="0,0,0,1" Padding="0,2">
                            <StackPanel>
                                <TextBlock Text="{Binding Identifier, StringFormat=Identifier: {0}}"/>
                                <TextBlock Text="{Binding Category, StringFormat=Result category: {0}}"/>
                                <TextBlock Text="{Binding Description, StringFormat=Verification note: {0}}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding HighlightTarget, StringFormat=Target: {0}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <TextBlock Text="Comparison differences" FontWeight="Bold" Margin="0,8,0,2"/>
        <TextBlock Text="{Binding VersionComparison.EvidenceAvailable, StringFormat=Evidence available: {0}}"/>
        <TextBlock Text="Files" FontWeight="Bold"/>
        <ItemsControl ItemsSource="{Binding VersionComparison.FileChanges}">
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Identifier}"/><TextBlock Text=": "/><TextBlock Text="{Binding Change}"/><TextBlock Text=" ("/><TextBlock Text="{Binding PreviousValue}"/><TextBlock Text=" -&gt; "/><TextBlock Text="{Binding CurrentValue}"/><TextBlock Text=")"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Dimensions" FontWeight="Bold"/>
        <ItemsControl ItemsSource="{Binding VersionComparison.DimensionChanges}">
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Identifier}"/><TextBlock Text=": "/><TextBlock Text="{Binding Change}"/><TextBlock Text=" ("/><TextBlock Text="{Binding PreviousValue}"/><TextBlock Text=" -&gt; "/><TextBlock Text="{Binding CurrentValue}"/><TextBlock Text=")"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="GD&amp;T controls" FontWeight="Bold"/>
        <ItemsControl ItemsSource="{Binding VersionComparison.GdtChanges}">
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Identifier}"/><TextBlock Text=": "/><TextBlock Text="{Binding Change}"/><TextBlock Text=" ("/><TextBlock Text="{Binding PreviousValue}"/><TextBlock Text=" -&gt; "/><TextBlock Text="{Binding CurrentValue}"/><TextBlock Text=")"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Metadata" FontWeight="Bold"/>
        <ItemsControl ItemsSource="{Binding VersionComparison.MetadataChanges}">
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Identifier}"/><TextBlock Text=": "/><TextBlock Text="{Binding Change}"/><TextBlock Text=" ("/><TextBlock Text="{Binding PreviousValue}"/><TextBlock Text=" -&gt; "/><TextBlock Text="{Binding CurrentValue}"/><TextBlock Text=")"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Message}"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrandError}"/>
        <TextBlock Text="{Binding DimensionResultsHeading}" FontWeight="Bold" Margin="0,16,0,8"/>
        <ItemsControl ItemsSource="{Binding Dimensions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BrandBorder}" BorderThickness="0,0,0,1" Padding="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DimensionType, StringFormat=Type: {0}}" Width="130"/>
                            <TextBlock Text="{Binding NominalValue, StringFormat=Nominal: {0}}" Width="160"/>
                            <TextBlock Text="{Binding LowerTolerance, StringFormat=Lower tolerance: {0}}" Width="180"/>
                            <TextBlock Text="{Binding UpperTolerance, StringFormat=Upper tolerance: {0}}" Width="180"/>
                            <TextBlock Text="{Binding DisplayText, StringFormat=Label: {0}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
