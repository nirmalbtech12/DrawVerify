<UserControl x:Class="DrawVerify.App.Views.DocumentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24"><TextBlock Text="Document details" FontSize="24"/><TextBlock Text="{Binding OriginalFileName}"/><TextBlock Text="{Binding FileSizeBytes, StringFormat=Size: {0} bytes}"/><TextBlock Text="{Binding UploadTimestampUtc}"/><TextBlock Text="{Binding UploaderUserId, StringFormat=Uploader: {0}}"/><TextBlock Text="{Binding UploaderDisplayName, StringFormat=Uploader name: {0}}"/><TextBlock Text="{Binding DocumentType}"/><TextBlock Text="{Binding UploadStatus}"/><TextBlock Text="{Binding VerificationStatusDisplay, StringFormat=Verification: {0}}"/><TextBlock Text="{Binding GeometryStatus}"/><TextBlock Text="{Binding CurrentVersion, StringFormat=Version: {0}}"/></StackPanel>
</UserControl>
