<UserControl x:Class="DrawVerify.App.Views.ViewerAccessView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
 <GroupBox Header="Viewer Access / Sharing" Margin="0,16,0,8"><StackPanel Margin="8">
  <TextBlock Text="Only approved documents can be shared with Viewers." Foreground="DarkOrange" Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False}"/>
  <StackPanel Orientation="Horizontal"><TextBox Width="220" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}" Margin="8,0"/><ComboBox Width="280" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="DisplayName"/></StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Grant access" Command="{Binding GrantCommand}" Margin="0,0,8,0"/><Button Content="Revoke access" Command="{Binding RevokeCommand}"/></StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding CanSetExpiration, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Expiration UTC:" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding ExpirationUtc}" Margin="8,0"/></StackPanel>
  <StackPanel Visibility="{Binding CanUseBulkActions, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Select approved document versions for the bulk action:"/><DataGrid ItemsSource="{Binding AvailableDocuments}" AutoGenerateColumns="False" Height="100" IsReadOnly="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Document / version" Binding="{Binding DisplayName}" IsReadOnly="True"/></DataGrid.Columns></DataGrid><CheckBox Content="Revoke selected access (clear to grant)" IsChecked="{Binding BulkRevoke}" Margin="0,4"/><StackPanel Orientation="Horizontal"><Button Content="Preview bulk action" Command="{Binding PreviewBulkCommand}" Margin="0,0,8,0"/><Button Content="Confirm bulk" Command="{Binding ConfirmBulkCommand}" IsEnabled="{Binding IsBulkConfirmationVisible}"/><Button Content="Cancel" Command="{Binding CancelBulkCommand}" Margin="8,0"/></StackPanel></StackPanel>
  <TextBlock Text="{Binding BulkSummary}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap"/>
  <DataGrid ItemsSource="{Binding Grants}" AutoGenerateColumns="False" IsReadOnly="True" Height="160"><DataGrid.Columns><DataGridTextColumn Header="Target" Binding="{Binding Target.DisplayName}"/><DataGridTextColumn Header="Type" Binding="{Binding Target.Kind}"/><DataGridTextColumn Header="Granted" Binding="{Binding GrantedUtc}"/><DataGridTextColumn Header="Granted by" Binding="{Binding GrantedByName}"/><DataGridTextColumn Header="Expires" Binding="{Binding ExpiresUtc}"/></DataGrid.Columns></DataGrid>
 </StackPanel></GroupBox>
</UserControl>
