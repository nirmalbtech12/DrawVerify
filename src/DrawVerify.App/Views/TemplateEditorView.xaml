<UserControl x:Class="DrawVerify.App.Views.TemplateEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:DrawVerify.App.ViewModels" xmlns:controls="clr-namespace:DrawVerify.App.Controls">
 <UserControl.Resources><vm:NormalizedCoordinateConverter x:Key="CoordinateConverter"/></UserControl.Resources>
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Template editor" FontSize="20" FontWeight="SemiBold"/>
   <StackPanel Orientation="Horizontal" Margin="0,8"><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Width="240"/><Button Content="Open" Command="{Binding OpenTemplateCommand}" CommandParameter="{Binding SelectedTemplate}" Margin="4,0"/></StackPanel>
   <WrapPanel Margin="0,4"><TextBlock Text="Signature role" VerticalAlignment="Center" Margin="2"/><ComboBox ItemsSource="{Binding SignatureRoleOptions}" SelectedItem="{Binding SignatureRole}" Width="110" Margin="2"/><TextBox Text="{Binding CustomRole, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="2" ToolTip="Custom role"/><TextBox Text="{Binding SignatureLabel, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="2" ToolTip="Signature label"/><CheckBox Content="Required" IsChecked="{Binding SignatureRequired}" Margin="2" VerticalAlignment="Center"/><Button Content="Insert signature" Command="{Binding InsertSignatureCommand}" Margin="2"/></WrapPanel>
   <WrapPanel Margin="0,4"><Button Content="Date" Command="{Binding InsertDateCommand}" Margin="2"/><Button Content="Document number" Command="{Binding InsertDocumentNumberCommand}" Margin="2"/><Button Content="Revision" Command="{Binding InsertRevisionCommand}" Margin="2"/><Button Content="Project name" Command="{Binding InsertProjectNameCommand}" Margin="2"/><TextBox Text="{Binding CustomTextName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="2" ToolTip="Custom text name"/><Button Content="Insert custom text" Command="{Binding InsertCustomTextCommand}" Margin="2"/></WrapPanel>
   <WrapPanel Margin="0,4"><Button Content="Align left" Command="{Binding AlignLeftCommand}" Margin="2"/><Button Content="Align center" Command="{Binding AlignCenterCommand}" Margin="2"/><Button Content="Align top" Command="{Binding AlignTopCommand}" Margin="2"/><Button Content="Save version" Command="{Binding SaveCommand}" Margin="2"/><Button Content="Preview" Command="{Binding PreviewCommand}" Margin="2"/></WrapPanel>
   <TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding ValidationErrors}" Foreground="DarkRed" TextWrapping="Wrap"/>
  </StackPanel>
  <Border BorderBrush="Gray" BorderThickness="1" Background="White" Width="800" Height="1100" HorizontalAlignment="Left" Margin="0,8">
   <ItemsControl ItemsSource="{Binding Placeholders}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="800" Height="1100"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource CoordinateConverter}, ConverterParameter=800}"/><Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource CoordinateConverter}, ConverterParameter=1100}"/></Style></ItemsControl.ItemContainerStyle>
    <ItemsControl.ItemTemplate><DataTemplate><controls:TemplatePlaceholderThumb Placeholder="{Binding}" Width="{Binding Position.Width, Converter={StaticResource CoordinateConverter}, ConverterParameter=800}" Height="{Binding Position.Height, Converter={StaticResource CoordinateConverter}, ConverterParameter=1100}"/></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </Border>
 </DockPanel>
</UserControl>
