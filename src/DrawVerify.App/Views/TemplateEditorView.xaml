<UserControl x:Class="DrawVerify.App.Views.TemplateEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Template editor" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,8"><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Width="240"/><Button Content="Open" Command="{Binding OpenTemplateCommand}" CommandParameter="{Binding SelectedTemplate}" Margin="4,0"/></StackPanel><WrapPanel Margin="0,8"><Button Content="Signature" Command="{Binding InsertSignatureCommand}" Margin="2"/><Button Content="Date" Command="{Binding InsertDateCommand}" Margin="2"/><Button Content="Document number" Command="{Binding InsertDocumentNumberCommand}" Margin="2"/><Button Content="Revision" Command="{Binding InsertRevisionCommand}" Margin="2"/><Button Content="Project name" Command="{Binding InsertProjectNameCommand}" Margin="2"/><Button Content="Save version" Command="{Binding SaveCommand}" Margin="2"/><Button Content="Preview" Command="{Binding PreviewCommand}" Margin="2"/></WrapPanel><TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding ValidationErrors}" Foreground="DarkRed" TextWrapping="Wrap"/></StackPanel><ListView ItemsSource="{Binding Placeholders}" Margin="0,8"><ListView.View><GridView><GridViewColumn Header="Label" DisplayMemberBinding="{Binding Label}"/><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}"/><GridViewColumn Header="Position" DisplayMemberBinding="{Binding Position.X}"/></GridView></ListView.View></ListView></DockPanel></UserControl>
