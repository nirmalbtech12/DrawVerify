<UserControl x:Class="DrawVerify.App.Views.DxfUploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="Upload Drawing" FontSize="24" />
        <TextBlock Text="Only DXF files (.dxf) are allowed." TextWrapping="Wrap" Margin="0,8" />
        <Button Content="Select DXF file" Command="{Binding SelectCommand}" Margin="0,16,0,8" />
        <TextBlock Text="{Binding FileName}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="20" Margin="0,12" />
        <StackPanel Orientation="Horizontal">
            <Button Content="Back" Click="BackClick" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Upload" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryAction}" />
        </StackPanel>
        <TextBlock Text="{Binding Message}" Margin="0,12" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
