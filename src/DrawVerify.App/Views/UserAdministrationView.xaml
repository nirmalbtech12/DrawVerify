<UserControl x:Class="DrawVerify.App.Views.UserAdministrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="ViewLoaded">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
  <ScrollViewer><StackPanel Margin="24" Width="520">
    <TextBlock Text="User administration" FontSize="24"/>
    <StackPanel Visibility="{Binding CanEditRoles,Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="Create user" Margin="0,16,0,4"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding UsernameError}" Foreground="Red" TextWrapping="Wrap"/>
      <TextBlock Text="Display name" Margin="0,10,0,4"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding DisplayNameError}" Foreground="Red" TextWrapping="Wrap"/>
      <TextBlock Text="Initial password" Margin="0,10,0,4"/><PasswordBox x:Name="InitialPasswordBox" PasswordChanged="PasswordChanged"/><TextBlock Text="{Binding InitialPasswordError}" Foreground="Red" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal"><Button Content="Create" Command="{Binding CreateCommand}" Margin="0,12,8,8"/><Button Content="Create Another" Command="{Binding CreateAnotherCommand}" Margin="0,12,8,8"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,12,8,8"/><Button Content="Back" Command="{Binding BackCommand}" Margin="0,12,0,8"/></StackPanel>
    </StackPanel>
    <TextBlock Text="Target user" FontWeight="Bold" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser,Mode=OneWayToSource}" DisplayMemberPath="Username"/>
    <TextBlock Text="Display name" Margin="0,10,0,4"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Email" Margin="0,10,0,4"/><TextBox Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}"/>
    <StackPanel Orientation="Horizontal"><Button Content="Save profile" Command="{Binding UpdateProfileCommand}" Margin="0,8,8,8"/><Button Content="Deactivate" Command="{Binding DeactivateCommand}" Margin="0,8"/></StackPanel>
    <TextBlock Text="Password reset" Margin="0,10,0,4"/><PasswordBox PasswordChanged="ResetPasswordChanged"/><Button Content="Reset password" Command="{Binding ResetPasswordCommand}" Margin="0,8"/>
    <TextBlock Text="Role editor" FontWeight="Bold" FontSize="16" Margin="0,12,0,4"/><TextBlock Text="Current roles" FontWeight="Bold" Margin="0,8,0,4"/><ItemsControl ItemsSource="{Binding CurrentRoles}"/><TextBlock Text="Proposed roles" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Changes are marked pending until you save."/><ItemsControl ItemsSource="{Binding RoleOptions}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected,Mode=TwoWay}" IsEnabled="{Binding DataContext.CanEditRoles,RelativeSource={RelativeSource AncestorType=ItemsControl}}"/><TextBlock Text=" — "/><TextBlock Text="{Binding Description}"/><TextBlock Text=" ({Binding StateLabel})" FontStyle="Italic"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Grid Margin="0,8" Visibility="{Binding CanEditRoles,Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="Back" Command="{Binding RoleBackCommand}" HorizontalAlignment="Left" Margin="0,0,8,0"/><Button Grid.Column="1" Content="Cancel" Command="{Binding RoleCancelCommand}" Margin="0,0,8,0"/><Button Grid.Column="4" Content="Save" Command="{Binding SetRolesCommand}"/></Grid><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
</UserControl>
