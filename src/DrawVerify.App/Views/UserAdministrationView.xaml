<UserControl x:Class="DrawVerify.App.Views.UserAdministrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="24" Width="520"><TextBlock Text="User administration" FontSize="24"/><TextBlock Text="Create user" Margin="0,16,0,4"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Display name" Margin="0,10,0,4"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Initial password" Margin="0,10,0,4"/><PasswordBox PasswordChanged="PasswordChanged"/><Button Content="Create" Command="{Binding CreateCommand}" Margin="0,12,0,8"/><TextBlock Text="Assigned roles" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding AssignedRoles}"/><TextBlock Text="Available system roles" FontWeight="Bold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding RoleCatalog}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><CheckBox Content="{Binding Name}" Command="{Binding DataContext.ToggleRoleCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}" IsEnabled="{Binding DataContext.CanEditRoles,RelativeSource={RelativeSource AncestorType=ItemsControl}}"/><TextBlock Text=" — "/><TextBlock Text="{Binding Description}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBox Text="{Binding SelectedUsername,UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,4"/><TextBlock Text="Enter the target username to edit its full role set." TextWrapping="Wrap"/><Button Content="Save roles" Command="{Binding SetRolesCommand}" IsEnabled="{Binding CanEditRoles}" Margin="0,8"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></UserControl>
