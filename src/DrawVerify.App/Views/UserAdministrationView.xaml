<UserControl x:Class="DrawVerify.App.Views.UserAdministrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="ViewLoaded"><UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources><ScrollViewer><StackPanel Margin="24" Width="520"><TextBlock Text="User administration" FontSize="24"/><StackPanel Visibility="{Binding CanEditRoles,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Create user" Margin="0,16,0,4"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Display name" Margin="0,10,0,4"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Initial password" Margin="0,10,0,4"/><PasswordBox PasswordChanged="PasswordChanged"/><Button Content="Create" Command="{Binding CreateCommand}" Margin="0,12,0,8"/></StackPanel><TextBlock Text="Assigned roles" FontWeight="Bold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding AssignedRoles}"/><TextBlock Text="Target user" FontWeight="Bold" Margin="0,12,0,4" Visibility="{Binding CanEditRoles,Converter={StaticResource BooleanToVisibilityConverter}}"/><ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser,Mode=OneWayToSource}" DisplayMemberPath="Username" Visibility="{Binding CanEditRoles,Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="Available system roles" FontWeight="Bold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding RoleOptions}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected,Mode=TwoWay}" IsEnabled="{Binding DataContext.CanEditRoles,RelativeSource={RelativeSource AncestorType=ItemsControl}}"/><TextBlock Text=" — "/><TextBlock Text="{Binding Description}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Save roles" Command="{Binding SetRolesCommand}" IsEnabled="{Binding CanEditRoles}" Margin="0,8" Visibility="{Binding CanEditRoles,Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></UserControl>
