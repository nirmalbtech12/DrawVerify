<UserControl x:Class="DrawVerify.App.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="8">
            <StackPanel Orientation="Horizontal"><Button Content="Back" Click="BackClick"/><TextBlock Text="Workflow" FontSize="24" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
            <TextBlock Text="{Binding Message}" Margin="0,16,0,4"/><TextBlock Text="{Binding ReviewError}" Foreground="DarkRed"/><TextBlock Text="Checker review queue" FontSize="18"/>
            <ListView ItemsSource="{Binding Queue}" Margin="0,8" SelectionChanged="QueueSelectionChanged"><ListView.View><GridView><GridViewColumn Header="Package" DisplayMemberBinding="{Binding PackageId}"/><GridViewColumn Header="Revision" DisplayMemberBinding="{Binding Revision}"/><GridViewColumn Header="Maker" DisplayMemberBinding="{Binding MakerDisplayName}"/><GridViewColumn Header="Submitted" DisplayMemberBinding="{Binding SubmittedUtc}"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Verification" DisplayMemberBinding="{Binding VerificationSummary}"/></GridView></ListView.View></ListView>
            <StackPanel Visibility="{Binding IsReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Submission package" FontSize="18"/><Button Content="Mark Documents Viewed" Command="{Binding MarkDocumentsViewedCommand}"/><TextBlock Text="{Binding ReviewPackage.StepDocumentVersionId, StringFormat=STEP version: {0}}"/><TextBlock Text="{Binding ReviewPackage.DxfDocumentVersionId, StringFormat=DXF version: {0}}"/><TextBlock Text="{Binding ReviewPackage.MakerDisplayName, StringFormat=Maker: {0}}"/><TextBlock Text="{Binding ReviewPackage.SubmittedUtc, StringFormat=Submitted: {0}}"/><TextBlock Text="{Binding ReviewPackage.Revision, StringFormat=Revision: {0}}"/><TextBlock Text="{Binding ReviewPackage.ExtractionEvidenceJson, StringFormat=Extraction: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReviewPackage.VerificationEvidenceJson, StringFormat=Verification: {0}}" TextWrapping="Wrap"/><Button Content="Mark Verification Viewed" Command="{Binding MarkVerificationViewedCommand}"/><TextBlock Text="{Binding ReviewPackage.Note, StringFormat=Notes: {0}}" TextWrapping="Wrap"/><ListView ItemsSource="{Binding ReviewPackage.VerificationFindings}" SelectedItem="{Binding SelectedVerificationFinding, Mode=TwoWay}" SelectionChanged="FindingSelectionChanged"/><TextBox Text="{Binding ReviewComment, UpdateSourceTrigger=PropertyChanged}" Margin="0,8"/><StackPanel Orientation="Horizontal"><Button Content="Approve" Command="{Binding ApproveCommand}"/><Button Content="Reject" Command="{Binding RejectCommand}" Margin="8,0"/><Button Content="Request Changes" Command="{Binding RequestChangesCommand}" Margin="8,0"/><Button Content="Save Comment" Command="{Binding SaveReviewCommentCommand}" Margin="8,0"/></StackPanel></StackPanel>
            <StackPanel Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Submission note"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Submit for Review" Command="{Binding SubmitCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0"/></StackPanel></StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
