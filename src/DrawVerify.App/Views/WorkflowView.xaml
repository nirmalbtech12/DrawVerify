<UserControl x:Class="DrawVerify.App.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:DrawVerifySignature="clr-namespace:DrawVerify.App.Controls">
             
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="8">
            <TextBlock Text="Rejection requires an overall reason; saved comments remain drafts until a decision is submitted." TextWrapping="Wrap"/><TextBlock Text="Approver rejection reason"/><TextBox Text="{Binding ApproverRejectionReason, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Reject to Checker" Command="{Binding RejectToCheckerCommand}"/>
            <StackPanel Margin="0,8,0,4"><TextBlock Text="Selected Maker rejection context" FontWeight="Bold"/><TextBlock Text="{Binding SelectedMakerPackage.Status, StringFormat=Status: {0}}"/><TextBlock Text="{Binding SelectedMakerPackage.PriorDecision.CheckerDisplayName, StringFormat=Checker: {0}}"/><TextBlock Text="{Binding SelectedMakerPackage.PriorDecision.DecidedUtc, StringFormat=Decision time: {0}}"/><TextBlock Text="{Binding SelectedMakerPackage.RejectionReason, StringFormat=Overall reason: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedMakerPackage.CorrectionAction, StringFormat=Correction action: {0}}" TextWrapping="Wrap"/></StackPanel>
            <ItemsControl ItemsSource="{Binding MakerReviewComments}" Margin="0,4"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,2"><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReferenceType, StringFormat=Reference type: {0}}"/><TextBlock Text="{Binding ReferenceId, StringFormat=Reference ID: {0}}"/><TextBlock Text="{Binding Location, StringFormat=Location: {0}}"/><TextBlock Text="{Binding PriorCommentId, StringFormat=Prior issue: {0}}"/><TextBlock Text="{Binding CorrectionResponse, StringFormat=Correction response: {0}}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <StackPanel><ListView ItemsSource="{Binding ReviewPackage.Comments}" SelectedItem="{Binding SelectedReviewComment, Mode=TwoWay}" MaxHeight="140"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,2"><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReferenceType, StringFormat=Reference type: {0}}"/><TextBlock Text="{Binding ReferenceId, StringFormat=Reference ID: {0}}"/><TextBlock Text="{Binding Location, StringFormat=Location: {0}}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBox Text="{Binding ReviewComment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Overall rejection reason or draft issue comment"/><TextBox Text="{Binding CorrectionAction, UpdateSourceTrigger=PropertyChanged}" ToolTip="Required correction action"/><ComboBox SelectedValue="{Binding ReferenceType, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" ToolTip="Issue reference type"><ComboBoxItem Content=""/><ComboBoxItem Content="drawing"/><ComboBoxItem Content="model"/><ComboBoxItem Content="dimension"/><ComboBoxItem Content="gdt"/></ComboBox><TextBox Text="{Binding ReferenceId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Drawing, model, dimension, or GD&amp;T reference ID"/><TextBox Text="{Binding ReferenceLocation, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reference location or annotation location"/><StackPanel Orientation="Horizontal"><Button Content="Save draft" Command="{Binding SaveReviewCommentCommand}"/><Button Content="Edit draft" Command="{Binding EditReviewCommentCommand}" Margin="4,0"/><Button Content="Discard draft" Command="{Binding DiscardReviewCommentCommand}" Margin="4,0"/><Button Content="Cancel" Command="{Binding CancelReviewCommand}" Margin="4,0"/></StackPanel></StackPanel>
            <StackPanel Orientation="Horizontal"><Button Content="Back" Click="BackClick"/><TextBlock Text="Workflow" FontSize="24" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
            <TextBlock Text="{Binding Message}" Margin="0,16,0,4"/><TextBlock Text="{Binding ReviewError}" Foreground="DarkRed"/><TextBlock Text="My submitted packages and review comments" FontSize="18" Margin="0,12,0,0"/><ListView ItemsSource="{Binding MakerPackages}" SelectionChanged="MakerPackageSelectionChanged" MaxHeight="120"><ListView.View><GridView><GridViewColumn Header="Package" DisplayMemberBinding="{Binding PackageId}"/><GridViewColumn Header="Revision" DisplayMemberBinding="{Binding Revision}"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView><ItemsControl ItemsSource="{Binding MakerReviewComments}" Margin="0,4"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Checker review queue" FontSize="18"/>
            <ListView ItemsSource="{Binding Queue}" Margin="0,8" SelectionChanged="QueueSelectionChanged"><ListView.View><GridView><GridViewColumn Header="Package" DisplayMemberBinding="{Binding PackageId}"/><GridViewColumn Header="Revision" DisplayMemberBinding="{Binding Revision}"/><GridViewColumn Header="Maker" DisplayMemberBinding="{Binding MakerDisplayName}"/><GridViewColumn Header="Submitted" DisplayMemberBinding="{Binding SubmittedUtc}"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Verification" DisplayMemberBinding="{Binding VerificationSummary}"/></GridView></ListView.View></ListView>
            <StackPanel Visibility="{Binding IsReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Submission package" FontSize="18"/><Button Content="Mark Documents Viewed" Command="{Binding MarkDocumentsViewedCommand}"/><TextBlock Text="{Binding ReviewPackage.StepDocumentVersionId, StringFormat=STEP version: {0}}"/><TextBlock Text="{Binding ReviewPackage.DxfDocumentVersionId, StringFormat=DXF version: {0}}"/><TextBlock Text="{Binding ReviewPackage.MakerDisplayName, StringFormat=Maker: {0}}"/><TextBlock Text="{Binding ReviewPackage.SubmittedUtc, StringFormat=Submitted: {0}}"/><TextBlock Text="{Binding ReviewPackage.Revision, StringFormat=Revision: {0}}"/><TextBlock Text="{Binding ReviewPackage.ExtractionEvidenceJson, StringFormat=Extraction: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReviewPackage.VerificationEvidenceJson, StringFormat=Verification: {0}}" TextWrapping="Wrap"/><Button Content="Mark Verification Viewed" Command="{Binding MarkVerificationViewedCommand}"/><TextBlock Text="{Binding ReviewPackage.Note, StringFormat=Notes: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReviewPackage.PriorDecision.DecisionType, StringFormat=Checker decision: {0}}"/><TextBlock Text="{Binding ReviewPackage.PriorDecision.DecidedUtc, StringFormat=Checker decision date: {0}}"/><TextBlock Text="{Binding ReviewPackage.PriorDecision.Comments, StringFormat=Checker comments: {0}}" TextWrapping="Wrap"/><TextBlock Text="Approval history" FontWeight="Bold" Margin="0,8,0,2"/><ItemsControl ItemsSource="{Binding ApprovalHistory}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,2"><TextBlock Text="{Binding DecisionType, StringFormat=Decision: {0}}"/><TextBlock Text="{Binding DecidedUtc, StringFormat=Date: {0}}"/><TextBlock Text="{Binding Revision, StringFormat=Revision: {0}}"/><TextBlock Text="{Binding CheckerDisplayName, StringFormat=Checker: {0}}"/><TextBlock Text="{Binding ApproverDisplayName, StringFormat=Approver: {0}}"/><TextBlock Text="{Binding Comments, StringFormat=Comments: {0}}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ListView ItemsSource="{Binding ReviewPackage.VerificationFindings}" SelectedItem="{Binding SelectedVerificationFinding, Mode=TwoWay}" SelectionChanged="FindingSelectionChanged"/><TextBox Text="{Binding ReviewComment, UpdateSourceTrigger=PropertyChanged}" Margin="0,8"/><StackPanel Orientation="Horizontal"><Button Content="Approve" Command="{Binding ApproveCommand}"/><Button Content="Reject" Command="{Binding RejectCommand}" Margin="8,0"/><Button Content="Return for Rework" Command="{Binding ReturnForReworkCommand}" Margin="8,0"/><Button Content="Request Changes" Command="{Binding RequestChangesCommand}" Margin="8,0"/><Button Content="Save Comment" Command="{Binding SaveReviewCommentCommand}" Margin="8,0"/></StackPanel></StackPanel>
            <StackPanel Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Submission note"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/><DrawVerifySignature:SignatureStampControl ToolTip="Maker signature: preview, then finalize before submission." Logger="{Binding Logger}" DocumentId="{Binding PackageId}" Revision="{Binding MakerSignature.Revision}" IsMaker="{Binding IsMaker}" MakerUserId="{Binding MakerUserId}" MakerDisplayName="{Binding MakerDisplayName}" FinalizedSignature="{Binding MakerSignature, Mode=TwoWay}"/><TextBlock Text="{Binding SignatureError}" Foreground="DarkRed"/><TextBlock Text="{Binding FingerprintProgressText}"/><StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Submit for Review" Command="{Binding SubmitCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0"/></StackPanel></StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
