<UserControl x:Class="DrawVerify.App.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
    <StackPanel Margin="8"><StackPanel Orientation="Horizontal"><Button Content="Back" Click="BackClick"/><TextBlock Text="Workflow" FontSize="24" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><TextBlock Text="{Binding Message}" Margin="0,16,0,4"/><TextBlock Text="Checker review queue" FontSize="18"/><ListView ItemsSource="{Binding Queue}" Margin="0,8"><ListView.View><GridView><GridViewColumn Header="Package" DisplayMemberBinding="{Binding PackageId}"/><GridViewColumn Header="Revision" DisplayMemberBinding="{Binding Revision}"/><GridViewColumn Header="Maker" DisplayMemberBinding="{Binding MakerDisplayName}"/><GridViewColumn Header="Submitted" DisplayMemberBinding="{Binding SubmittedUtc}"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Verification" DisplayMemberBinding="{Binding VerificationSummary}"/></GridView></ListView.View></ListView><StackPanel Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Submission note"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Submit for Review" Command="{Binding SubmitCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0"/></StackPanel></StackPanel></StackPanel>
</UserControl>
