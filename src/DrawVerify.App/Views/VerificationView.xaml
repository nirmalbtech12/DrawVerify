<UserControl x:Class="DrawVerify.App.Views.VerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DeltaCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding DeltaBrush}" />
            <Setter Property="FontWeight" Value="{Binding DeltaFontWeight}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="8">
            <TextBlock Text="Verification session selection" FontWeight="Bold" />
            <WrapPanel Margin="0,6,0,4"><TextBox Width="260" Text="{Binding StepDocumentId, UpdateSourceTrigger=PropertyChanged}" ToolTip="STEP document ID"/><TextBox Width="260" Margin="6,0,0,0" Text="{Binding DxfDocumentId, UpdateSourceTrigger=PropertyChanged}" ToolTip="DXF document ID"/><Button Content="Select pair/session" Command="{Binding SelectPairCommand}" Margin="6,0,0,0"/><Button Content="Match dimensions" Command="{Binding MatchDimensionsCommand}" Margin="6,0,0,0"/><Button Content="Refresh" Command="{Binding RefreshMatchesCommand}" Margin="6,0,0,0"/><TextBox Width="70" Margin="6,0,0,0" Text="{Binding ToleranceThresholdInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tolerance in mm"/><Button Content="Re-run tolerance" Command="{Binding UpdateToleranceCommand}" Margin="6,0,0,0"/></WrapPanel>
            <TextBlock Text="{Binding UnmatchedDimensionsTitle}" FontWeight="Bold" Foreground="DarkRed" Margin="0,4,0,2"/>
            <GroupBox Header="Comparison Summary" Margin="0,0,0,6">
                <StackPanel Margin="6">
                    <WrapPanel>
                        <TextBlock Text="Total Dimensions: " FontWeight="Bold"/><TextBlock Text="{Binding TotalDimensions}" Margin="0,0,12,0"/>
                        <TextBlock Text="Matched: " FontWeight="Bold"/><TextBlock Text="{Binding MatchedDimensions}" Margin="0,0,12,0"/>
                        <TextBlock Text="Mismatched: " FontWeight="Bold"/><TextBlock Text="{Binding MismatchedDimensions}" Margin="0,0,12,0"/>
                        <TextBlock Text="Unmatched: " FontWeight="Bold"/><TextBlock Text="{Binding UnmatchedDimensions}" Margin="0,0,12,0"/>
                        <TextBlock Text="Missing Dimensions: " FontWeight="Bold"/><TextBlock Text="{Binding MissingDimensions}" Margin="0,0,12,0"/>
                        <TextBlock Text="Match: " FontWeight="Bold"/><TextBlock Text="{Binding MatchPercentageText}"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding DimensionTypeSummaries}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding DimensionType}"/><Run Text=": "/><Run Text="{Binding MatchedDimensions}"/><Run Text=" Matched, "/><Run Text="{Binding MismatchedDimensions}"/><Run Text=" Mismatched, "/><Run Text="{Binding UnmatchedDimensions}"/><Run Text=" Unmatched"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>
            <ItemsControl ItemsSource="{Binding StatusSummaries}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock><Run Text="{Binding DimensionType}"/><Run Text=": "/><Run Text="{Binding MatchedCount}"/><Run Text=" Matched, "/><Run Text="{Binding MismatchedCount}"/><Run Text=" Mismatched, "/><Run Text="{Binding UnmatchedCount}"/><Run Text=" Unmatched"/></TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,0,0,4"><TextBlock Text="Filter:" VerticalAlignment="Center"/><ComboBox Width="150" Margin="6,0,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"/><TextBox Width="180" Margin="6,0,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search label, value, type, or reason"/><Button Content="Apply" Command="{Binding ApplyFilterCommand}" Margin="6,0,0,0"/><TextBlock Text="Sort by:" Margin="12,0,0,0" VerticalAlignment="Center"/><ComboBox Width="130" Margin="6,0,0,0" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}"/><CheckBox Content="Descending" IsChecked="{Binding SortDescending}" Margin="12,0,0,0"/><Button Content="Sort" Command="{Binding SortResultsCommand}" Margin="6,0,0,0"/></WrapPanel>
            <TextBlock Text="{Binding ToleranceSummary}" Margin="0,4,0,2" />
            <TextBlock Text="{Binding MatchingStatus}" Margin="0,4,0,8" />
            <GroupBox Header="Unmatched Dimensions (Missing from 3D)" Margin="0,0,0,6">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding UnmatchedResults}" SelectedItem="{Binding SelectedUnmatchedDimension, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180">
                        <DataGrid.Columns><DataGridTextColumn Header="Reference" Binding="{Binding Match.DxfDimensionReference}"/><DataGridTextColumn Header="Value" Binding="{Binding NominalValue}"/><DataGridTextColumn Header="Tolerance" Binding="{Binding Tolerance}"/><DataGridTextColumn Header="Layer" Binding="{Binding Layer}"/><DataGridTextColumn Header="Annotation" Binding="{Binding DimensionText}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}"/><DataGridTextColumn Header="Comment" Binding="{Binding Comment}"/><DataGridTextColumn Header="Resolution" Binding="{Binding ResolutionStatus}"/></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBox Width="260" Text="{Binding MissingDimensionComment, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Add comment" Command="{Binding AddMissingDimensionCommentCommand}" Margin="6,0,0,0"/><Button Content="Accept" Command="{Binding ResolveMissingDimensionCommand}" CommandParameter="Accepted" Margin="6,0,0,0"/><Button Content="Reject" Command="{Binding ResolveMissingDimensionCommand}" CommandParameter="Rejected" Margin="6,0,0,0"/></StackPanel>
                </StackPanel>
            </GroupBox>
            <ContentControl Content="{Binding DxfPreview}" Margin="0,0,0,6" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding MatchResults}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{Binding StatusBrush}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}"/><DataGridTextColumn Header="Dimension type" Binding="{Binding DimensionType}"/><DataGridTextColumn Header="Nominal value" Binding="{Binding NominalValue}"/><DataGridTextColumn Header="Measured value" Binding="{Binding MeasuredValue}"/><DataGridTextColumn Header="Absolute delta" Binding="{Binding AbsoluteDelta}" CellStyle="{StaticResource DeltaCellStyle}"/><DataGridTextColumn Header="Signed delta (DXF − STEP)" Binding="{Binding SignedDelta}" CellStyle="{StaticResource DeltaCellStyle}"/><DataGridTextColumn Header="Tolerance" Binding="{Binding Tolerance}"/><DataGridTextColumn Header="Tolerance source" Binding="{Binding ToleranceSource}"/><DataGridTextColumn Header="DXF reference" Binding="{Binding Match.DxfDimensionReference}"/><DataGridTextColumn Header="Dimension text" Binding="{Binding DimensionText}"/><DataGridTextColumn Header="STEP geometry" Binding="{Binding GeometryReference}"/><DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceLabel}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}"/><DataGridTextColumn Header="Explanation" Binding="{Binding ReasonExplanation}"/></DataGrid.Columns>
        </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
