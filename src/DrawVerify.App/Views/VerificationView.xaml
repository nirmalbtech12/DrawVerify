<UserControl x:Class="DrawVerify.App.Views.VerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="8">
            <TextBlock Text="Verification session selection" FontWeight="Bold" />
            <WrapPanel Margin="0,6,0,4"><TextBox Width="260" Text="{Binding StepDocumentId, UpdateSourceTrigger=PropertyChanged}" ToolTip="STEP document ID"/><TextBox Width="260" Margin="6,0,0,0" Text="{Binding DxfDocumentId, UpdateSourceTrigger=PropertyChanged}" ToolTip="DXF document ID"/><Button Content="Select pair/session" Command="{Binding SelectPairCommand}" Margin="6,0,0,0"/><Button Content="Match dimensions" Command="{Binding MatchDimensionsCommand}" Margin="6,0,0,0"/><Button Content="Refresh" Command="{Binding RefreshMatchesCommand}" Margin="6,0,0,0"/></WrapPanel>
            <WrapPanel Margin="0,0,0,4"><TextBlock Text="Filter:" VerticalAlignment="Center"/><ComboBox Width="150" Margin="6,0,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"/><Button Content="Apply" Command="{Binding ApplyFilterCommand}" Margin="6,0,0,0"/><CheckBox Content="Sort descending" IsChecked="{Binding SortDescending}" Margin="12,0,0,0"/><Button Content="Sort" Command="{Binding SortResultsCommand}" Margin="6,0,0,0"/></WrapPanel>
            <TextBlock Text="{Binding MatchingStatus}" Margin="0,4,0,8" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding MatchResults}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}"/><DataGridTextColumn Header="DXF reference" Binding="{Binding Match.DxfDimensionReference}"/><DataGridTextColumn Header="STEP geometry" Binding="{Binding GeometryReference}"/><DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceLabel}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}"/></DataGrid.Columns>
        </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
