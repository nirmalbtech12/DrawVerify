<UserControl x:Class="DrawVerify.App.Views.SharedDocumentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="24"><TextBlock Text="Shared approved documents" FontSize="22"/><StackPanel Orientation="Horizontal" Margin="0,12"><TextBox Width="300" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}" Margin="8,0"/></StackPanel><TextBlock Text="{Binding Status}" Margin="0,4"/><DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Document" Binding="{Binding DocumentName}"/><DataGridTextColumn Header="Revision" Binding="{Binding RevisionText}"/><DataGridTextColumn Header="Status" Binding="{Binding ApprovalStatus}"/><DataGridTextColumn Header="Final approval" Binding="{Binding FinalApprovalUtc}"/><DataGridTextColumn Header="Approver" Binding="{Binding ApproverName}"/><DataGridTextColumn Header="Shared by" Binding="{Binding SharedByName}"/><DataGridTemplateColumn Header="Open"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></UserControl>
