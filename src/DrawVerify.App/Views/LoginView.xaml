<UserControl x:Class="DrawVerify.App.Views.LoginView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="48" Width="360"><TextBlock Text="Sign in" FontSize="28"/><TextBlock Text="Username" Margin="0,24,0,4"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Password" Margin="0,12,0,4"/><PasswordBox PasswordChanged="PasswordChanged"/><Button Content="Log in" Command="{Binding LoginCommand}" Margin="0,20,0,8"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></UserControl>
