<UserControl x:Class="DrawVerify.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ShellBackground}">
    <UserControl.Resources>
        <!-- Keep the login action available when this view is constructed before application dictionaries are loaded. -->
        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrandGreenDark}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandGreen}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="32">
        <Border MaxWidth="920" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BrandBorder}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Border Padding="48" Background="{DynamicResource SurfaceRaisedBackground}" CornerRadius="11,0,0,11">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="88" Height="88" HorizontalAlignment="Left" Background="{DynamicResource BrandGreen}" CornerRadius="14">
                            <Image Source="{DynamicResource BrandLogoSource}" Stretch="Uniform" Margin="3" />
                        </Border>
                        <TextBlock Text="DrawVerify" FontSize="30" FontWeight="Bold" Margin="0,24,0,6" />
                        <TextBlock Text="Engineering verification, with every dimension in view." Foreground="{DynamicResource BrandMuted}" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Margin="40" VerticalAlignment="Center">
                    <TextBlock Text="Sign in" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Use your DrawVerify account to continue." Foreground="{DynamicResource BrandMuted}" Margin="0,6,0,24" TextWrapping="Wrap" />
                    <TextBlock Text="Username" Foreground="{DynamicResource BrandMuted}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Password" Foreground="{DynamicResource BrandMuted}" Margin="0,16,0,6" />
                    <PasswordBox PasswordChanged="PasswordChanged" />
                    <TextBlock Text="License &amp; terms" Foreground="{DynamicResource BrandGreen}" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrandMuted}" FontSize="11">
                        <Hyperlink NavigateUri="LICENSE.txt" RequestNavigate="LicenseLinkRequested">DrawVerify license</Hyperlink>
                        <Run Text=" · " />
                        <Hyperlink NavigateUri="https://www.gnu.org/licenses/lgpl-3.0.html" RequestNavigate="LicenseLinkRequested">LGPL-3.0</Hyperlink>
                        <Run Text=" · " />
                        <Hyperlink NavigateUri="https://dev.opencascade.org/doc/occt-8.0.0/overview/html/" RequestNavigate="LicenseLinkRequested">OCCT LGPL-2.1</Hyperlink>
                    </TextBlock>
                    <CheckBox IsChecked="{Binding LicenseAccepted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0">
                        <TextBlock Text="I accept the terms and license" TextWrapping="Wrap" Foreground="{DynamicResource BrandWhite}" />
                    </CheckBox>
                    <Button Content="Sign in" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryAction}" Height="42" Margin="0,24,0,8" HorizontalContentAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource BrandError}" TextWrapping="Wrap" />
                    <TextBlock Text="© 2026 LEMU Technologies" Foreground="{DynamicResource BrandMuted}" FontSize="11" Margin="0,20,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
