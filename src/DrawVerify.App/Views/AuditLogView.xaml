<UserControl x:Class="DrawVerify.App.Views.AuditLogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="24"><TextBlock Text="Audit log" FontSize="24"/><StackPanel Orientation="Horizontal"><TextBox Width="120" Margin="0,12,8,12" ToolTip="From UTC" Text="{Binding From,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" ToolTip="To UTC" Text="{Binding To,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" Text="{Binding Action,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" Text="{Binding Actor,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Filter" Command="{Binding QueryCommand}" Margin="0,12,8,12"/><Button Content="Export CSV" Command="{Binding ExportCommand}" Margin="0,12,8,12"/></StackPanel><DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="True" IsReadOnly="True"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></UserControl>
