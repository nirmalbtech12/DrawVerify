<UserControl x:Class="DrawVerify.App.Views.AuditLogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="24"><TextBlock Text="Document audit trail" FontSize="24"/><StackPanel Orientation="Horizontal"><TextBox Width="120" Margin="0,12,8,12" ToolTip="From" Text="{Binding From,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" ToolTip="To" Text="{Binding To,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" ToolTip="Action" Text="{Binding Action,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" ToolTip="Actor" Text="{Binding Actor,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" ToolTip="Revision" Text="{Binding Revision,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="120" Margin="0,12,8,12" ToolTip="Search" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Filter" Command="{Binding QueryCommand}" Margin="0,12,8,12"/><Button Content="Export CSV" Command="{Binding ExportCommand}" Margin="0,12,8,12"/></StackPanel><DataGrid ItemsSource="{Binding DocumentEntries}" AutoGenerateColumns="True" IsReadOnly="True"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></UserControl>
