<UserControl x:Class="DrawVerify.App.Views.ReportTemplateConfigurationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="24" Width="800"><TextBlock Text="Report Template Configuration" FontSize="24"/><TextBlock Text="Configure organization report branding, sections, tables, summary, footer, and styling." TextWrapping="Wrap" Margin="0,4"/><ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Height="120"/><StackPanel Orientation="Horizontal"><Button Content="New" Command="{Binding NewCommand}" Margin="0,8,8,8"/><Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,8,8,8"/><Button Content="Set organization default" Command="{Binding DefaultCommand}" Margin="0,8,8,8"/><Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,8,8,8"/></StackPanel><GroupBox Header="Header and branding" Margin="0,4"><StackPanel Margin="8"><TextBox Text="{Binding SelectedTemplate.Header.OrganizationName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding SelectedTemplate.Header.OrganizationAddress,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding SelectedTemplate.Header.ReportTitleFormat,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox><GroupBox Header="Footer" Margin="0,4"><StackPanel Margin="8"><TextBox Text="{Binding SelectedTemplate.Footer.Text,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding SelectedTemplate.Footer.PageNumberFormat,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox><Button Content="Save" Command="{Binding SaveCommand}" Margin="0,12,0,8"/><Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,0,8"/><TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding ValidationErrors}" Foreground="DarkRed" TextWrapping="Wrap"/></StackPanel></ScrollViewer></UserControl>
