<UserControl x:Class="DrawVerify.App.Views.ReportTemplateConfigurationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="24" Width="900" IsEnabled="{Binding CanEdit}">
  <TextBlock Text="Report Template Configuration" FontSize="24"/><TextBlock Text="Configure organization report branding, sections, tables, summary, footer, and styling." TextWrapping="Wrap" Margin="0,4"/>
  <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Height="120"/>
  <StackPanel Orientation="Horizontal"><Button Content="New" Command="{Binding NewCommand}"/><Button Content="Duplicate" Command="{Binding DuplicateCommand}"/><Button Content="Upload PDF" Click="UploadPdf_Click"/><Button Content="Re-convert PDF" Command="{Binding ReconvertCommand}"/><Button Content="Set organization default" Command="{Binding DefaultCommand}"/><Button Content="Delete" Command="{Binding DeleteCommand}"/></StackPanel>
  <GroupBox Header="Header and branding"><StackPanel Margin="8"><TextBox Text="{Binding OrganizationName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding OrganizationAddress,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding ReportTitleFormat,UpdateSourceTrigger=PropertyChanged}"/><StackPanel Orientation="Horizontal"><TextBox Width="500" Text="{Binding LogoAssetPath,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Select logo" Click="SelectLogo_Click"/></StackPanel><TextBox Text="{Binding LogoPosition,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding TextAlignment,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox>
  <GroupBox Header="Footer and document control"><StackPanel Margin="8"><TextBox Text="{Binding FooterText,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding PageNumberFormat,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding TemplateVersionLabel,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding EffectiveDate,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox>
  <GroupBox Header="Sections"><StackPanel Margin="8"><ItemsControl ItemsSource="{Binding Sections}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding Enabled,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="180" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="300" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Up" Command="{Binding DataContext.MoveSectionUpCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/><Button Content="Down" Command="{Binding DataContext.MoveSectionDownCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></GroupBox>
  <GroupBox Header="Dimensions table columns and rules"><StackPanel Margin="8"><ItemsControl ItemsSource="{Binding DimensionsColumns}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Width="120" Text="{Binding Field}"/><TextBox Width="180" Text="{Binding Label,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="60" Text="{Binding Precision,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="80" Text="{Binding Unit,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding DimensionsRules}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBox Width="120" Text="{Binding Field,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="100" Text="{Binding Operator,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="100" Text="{Binding ValueText,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="100" Text="{Binding Color,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></GroupBox>
  <GroupBox Header="GD&amp;T table columns and rules"><StackPanel Margin="8"><ItemsControl ItemsSource="{Binding GdtColumns}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Width="120" Text="{Binding Field}"/><TextBox Width="180" Text="{Binding Label,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="60" Text="{Binding Precision,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="80" Text="{Binding Unit,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding GdtRules}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBox Width="120" Text="{Binding Field,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="100" Text="{Binding Operator,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="100" Text="{Binding ValueText,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="100" Text="{Binding Color,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></GroupBox>
  <GroupBox Header="Summary"><StackPanel Margin="8"><TextBox Text="{Binding SummaryLayout,UpdateSourceTrigger=PropertyChanged}"/><ItemsControl ItemsSource="{Binding Statistics}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Width="130" Text="{Binding Key}"/><TextBox Width="180" Text="{Binding Label,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="100" Text="{Binding Format,UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="60" Text="{Binding Ordinal,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></GroupBox>
  <GroupBox Header="Style"><StackPanel Margin="8"><TextBox Text="{Binding HeadingFontFamily,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding BodyFontFamily,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding TableFontFamily,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding HeadingFontSize,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding BodyFontSize,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding TableFontSize,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding HeaderColor,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding BorderColor,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding HighlightColor,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Margin,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Orientation,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox>
  <StackPanel Orientation="Horizontal"><Button Content="Save" Command="{Binding SaveCommand}"/><Button Content="Preview" Command="{Binding PreviewCommand}"/></StackPanel><TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding ValidationErrors}" Foreground="DarkRed" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
