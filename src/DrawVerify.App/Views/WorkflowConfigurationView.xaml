<UserControl x:Class="DrawVerify.App.Views.WorkflowConfigurationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="24" Width="760">
  <TextBlock Text="Workflow configuration" FontSize="24"/>
  <TextBlock Text="Only Admins with workflow-configuration permission can edit these rules." TextWrapping="Wrap" Margin="0,4"/>
  <GroupBox Header="Role definitions" Margin="0,12,0,4"><StackPanel Margin="8"><ItemsControl ItemsSource="{Binding Configuration.Roles}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="1" Text="{Binding SystemRole,UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding Permissions}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></GroupBox>
  <GroupBox Header="Approval stages, modes, quorum, rejection and delegation" Margin="0,4"><ItemsControl ItemsSource="{Binding Configuration.Stages}" Margin="8"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/><ColumnDefinition Width="80"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><ComboBox Grid.Column="1" Text="{Binding Mode,UpdateSourceTrigger=PropertyChanged}" Margin="6,0"/><TextBox Grid.Column="2" Text="{Binding RequiredApprovals,UpdateSourceTrigger=PropertyChanged}" Margin="6,0"/><TextBox Grid.Column="3" Text="{Binding Roles}" Margin="6,0"/><TextBlock Grid.Column="4" Text="{Binding RejectTo}" Margin="6,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
  <GroupBox Header="Triggers and conditions" Margin="0,4"><ItemsControl ItemsSource="{Binding Configuration.Triggers}" Margin="8"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding DocumentTypes,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Projects,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Departments,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
  <GroupBox Header="Statuses and authorized transitions" Margin="0,4"><StackPanel Margin="8"><ItemsControl ItemsSource="{Binding Configuration.StatusLabels}"/><ItemsControl ItemsSource="{Binding Configuration.StatusTransitions}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBox Text="{Binding From}"/><TextBlock Text=" → "/><TextBox Text="{Binding To}"/><TextBox Text="{Binding AuthorizedRoles}" Margin="8,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></GroupBox>
  <GroupBox Header="Notifications and reminders" Margin="0,4"><ItemsControl ItemsSource="{Binding Configuration.Notifications}" Margin="8"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBox Text="{Binding Event}"/><TextBox Text="{Binding RecipientRoles}"/><TextBox Text="{Binding Channels}"/><TextBox Text="{Binding ContentTemplate}"/><CheckBox Content="Reminder enabled" IsChecked="{Binding ReminderEnabled}"/><TextBox Text="{Binding ReminderInterval}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
  <GroupBox Header="Revision and rollout rules" Margin="0,4"><StackPanel Margin="8"><CheckBox Content="Create revision on submission" IsChecked="{Binding Configuration.RevisionPolicy.CreateRevisionOnSubmission}"/><TextBox Text="{Binding Configuration.RevisionPolicy.NumberFormat}"/><CheckBox Content="Retain rejected revisions" IsChecked="{Binding Configuration.RevisionPolicy.RetainRejectedRevisions}"/><ComboBox Text="{Binding Configuration.RolloutPolicy}"/></StackPanel></GroupBox>
  <StackPanel Orientation="Horizontal"><Button Content="Save" Command="{Binding SaveCommand}" Margin="0,12,8,8"/><Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,12,8,8"/></StackPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding ValidationErrors}" Foreground="DarkRed" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
