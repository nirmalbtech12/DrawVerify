<UserControl x:Class="DrawVerify.App.Views.WorkflowConfigurationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="24" Width="700"><TextBlock Text="Workflow configuration" FontSize="24"/><TextBlock Text="Role definitions" FontSize="18" Margin="0,16,0,4"/><TextBlock Text="{Binding RolesSummary}" TextWrapping="Wrap"/><TextBlock Text="Approval stages, triggers, statuses, notifications, revision and rollout rules are managed as one versioned configuration." TextWrapping="Wrap" Margin="0,12"/><StackPanel Orientation="Horizontal"><Button Content="Save" Command="{Binding SaveCommand}" Margin="0,8,8,8"/><Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,8"/></StackPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding ValidationErrors}" Foreground="DarkRed" TextWrapping="Wrap"/></StackPanel></ScrollViewer></UserControl>
