<UserControl x:Class="DrawVerify.App.Views.InternalSharedLinkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Internal shared links" FontSize="22"/><ComboBox ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}" DisplayMemberPath="FullUrl" Margin="0,12,0,4"/><StackPanel Orientation="Horizontal"><Button Content="Generate link" Command="{Binding GenerateCommand}" Margin="0,0,8,0"/><Button Content="Copy link" Command="{Binding CopyLinkCommand}" Margin="0,0,8,0"/><Button Content="Revoke" Command="{Binding RevokeCommand}" Margin="0,0,8,0"/><Button Content="Regenerate" Command="{Binding RegenerateCommand}"/></StackPanel><TextBlock Text="{Binding SelectedLink.Status}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedLink.FullUrl}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedLink.ExpiresUtc}"/><TextBlock Text="{Binding SelectedLink.AccessCount}"/><TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></UserControl>
