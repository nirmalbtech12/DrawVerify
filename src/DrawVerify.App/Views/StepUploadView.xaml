<UserControl x:Class="DrawVerify.App.Views.StepUploadView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="24"><TextBlock Text="Upload Model" FontSize="24"/><TextBlock Text="Only STEP files (.step, .stp) are allowed. Please ensure the file is a valid STEP format." TextWrapping="Wrap" Margin="0,8"/><Button Content="Select STEP file" Command="{Binding SelectCommand}" Margin="0,16,0,8"/><TextBlock Text="{Binding FileName}"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="20" Margin="0,12"/><StackPanel Orientation="Horizontal"><Button Content="Upload" Command="{Binding UploadCommand}" Margin="0,0,8,0"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></StackPanel><TextBlock Text="{Binding Message}" Margin="0,12" TextWrapping="Wrap"/></StackPanel>
</UserControl>
