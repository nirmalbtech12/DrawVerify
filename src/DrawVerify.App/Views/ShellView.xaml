<UserControl x:Class="DrawVerify.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{DynamicResource ShellBackground}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BrandBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="54" Height="54" CornerRadius="10" Background="{DynamicResource BrandGreen}" Margin="0,0,14,0">
                    <Image Source="{DynamicResource BrandLogoSource}" Stretch="Uniform" Margin="3" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DrawVerify" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Engineering verification platform" Foreground="{DynamicResource BrandMuted}" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Menu x:Name="ApplicationMenu" DockPanel.Dock="Top" KeyboardNavigation.IsTabStop="True" />
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBackground}"
                BorderBrush="{DynamicResource BrandBorder}" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource BrandMuted}" />
        </Border>
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="CURRENT WORKSPACE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandMuted}" />
                    <TextBlock x:Name="ScreenTitle" Text="Dashboard" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,6" TextWrapping="Wrap" />
                    <TextBlock x:Name="Breadcrumb" Text="Dashboard" Foreground="{DynamicResource BrandMuted}" TextWrapping="Wrap" />
                    <Separator Margin="0,20" Background="{DynamicResource BrandBorder}" />
                    <Button x:Name="BackButton" Content="Back" Click="BackClick" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                <ContentControl x:Name="ContentHost" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
