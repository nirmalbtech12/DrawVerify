<UserControl x:Class="DrawVerify.App.Views.ApprovedDocumentViewerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Approved document viewer" FontSize="22"/><TextBlock Text="{Binding Document.DocumentName}" FontSize="18" Margin="0,12,0,0"/><TextBlock Text="{Binding Document.ApprovalStatus}"/><TextBlock Text="{Binding Document.ApproverName}"/><TextBlock Text="{Binding Document.FinalApprovalUtc}"/><TextBlock Text="{Binding Document.ApprovalStamp}"/><TextBlock Text="{Binding Document.ApproverSignature}"/><Button Content="Download" Command="{Binding DownloadCommand}" Margin="0,12,0,0"/><TextBlock Text="{Binding Status}"/></StackPanel></ScrollViewer></UserControl>
