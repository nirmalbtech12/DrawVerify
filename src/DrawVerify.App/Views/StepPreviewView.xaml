<UserControl x:Class="DrawVerify.App.Views.StepPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="SteelBlue" BorderThickness="1" Padding="6" MinHeight="280">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="STEP 3D Preview" FontWeight="Bold" />
            <Viewport3D Grid.Row="1" Margin="0,6" ClipToBounds="True">
                <Viewport3D.Camera><PerspectiveCamera Position="{Binding CameraPosition}" LookDirection="{Binding CameraLookDirection}" UpDirection="{Binding CameraUpDirection}" FieldOfView="45" /></Viewport3D.Camera>
                <ModelVisual3D Content="{Binding ModelContent}" />
                <ModelVisual3D Content="{Binding HighlightContent}" />
                <ModelVisual3D><ModelVisual3D.Content><AmbientLight Color="#808080" /></ModelVisual3D.Content></ModelVisual3D>
            </Viewport3D>
            <StackPanel Grid.Row="2"><TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" /><TextBlock Text="{Binding CameraStatus}" TextWrapping="Wrap" /></StackPanel>
        </Grid>
    </Border>
</UserControl>
