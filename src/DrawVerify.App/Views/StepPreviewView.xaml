<UserControl x:Class="DrawVerify.App.Views.StepPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="STEP Preview" Padding="6">
        <StackPanel>
            <TextBlock Text="{Binding SelectionStatus}" />
            <TextBlock Text="{Binding SelectedFeatureReference, StringFormat=Feature: {0}}" />
            <TextBlock Text="{Binding TargetX, StringFormat=X: {0}}" />
            <TextBlock Text="{Binding TargetY, StringFormat=Y: {0}}" />
            <TextBlock Text="{Binding TargetZ, StringFormat=Z: {0}}" />
        </StackPanel>
    </GroupBox>
</UserControl>
