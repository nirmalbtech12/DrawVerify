<UserControl x:Class="DrawVerify.App.Views.CombinedUploadVerifyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DrawVerify.App.Views">
  <UserControl.Resources><DataTemplate x:Key="StepUploadTemplate"><views:StepUploadView/></DataTemplate><DataTemplate x:Key="DxfUploadTemplate"><views:DxfUploadView/></DataTemplate><DataTemplate x:Key="VerificationTemplate"><views:VerificationView/></DataTemplate></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <StackPanel Orientation="Horizontal"><Button Content="Back" Click="BackClick"/><TextBlock Text="Upload &amp; Verify" FontSize="24" Margin="12,0,0,0"/></StackPanel>
    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrandError}" TextWrapping="Wrap" Margin="0,8"/>
    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><GroupBox Grid.Column="0" Header="{Binding Step1Label}" Margin="0,0,6,0"><StackPanel><ContentControl Content="{Binding StepUpload}" ContentTemplate="{StaticResource StepUploadTemplate}"/><TextBlock Text="{Binding StepStatus}" Margin="0,4"/></StackPanel></GroupBox><GroupBox Grid.Column="1" Header="{Binding Step2Label}" Margin="6,0,0,0"><StackPanel><ContentControl Content="{Binding DxfUpload}" ContentTemplate="{StaticResource DxfUploadTemplate}"/><TextBlock Text="{Binding DxfStatus}" Margin="0,4"/></StackPanel></GroupBox></Grid>
    <GroupBox Header="{Binding Step3Label}" Margin="0,4"><StackPanel><TextBlock Text="{Binding ProcessingStatus}"/><Button Content="Verify" Command="{Binding VerifyCommand}" Margin="0,6" Width="120" HorizontalAlignment="Left"/></StackPanel></GroupBox>
    <GroupBox Header="{Binding Step4Label}" Margin="0,4"><StackPanel><TextBlock Text="{Binding Verification.MatchingStatus}"/><TextBlock Text="{Binding Verification.MatchPercentageText}"/><ContentControl Content="{Binding Verification}" ContentTemplate="{StaticResource VerificationTemplate}"/></StackPanel></GroupBox>
    <Button Content="Start New Upload &amp; Verify Workflow" Command="{Binding NewWorkflowCommand}" Margin="0,8" HorizontalAlignment="Left"/>
  </StackPanel></ScrollViewer>
</UserControl>
