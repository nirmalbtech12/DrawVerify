<Window x:Class="DrawVerify.App.Views.LicenseViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrawVerify license"
        Width="760"
        Height="620"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ShellBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="DrawVerify license" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBox x:Name="LicenseText"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="12"
                 FontFamily="Consolas"
                 Background="{DynamicResource SurfaceBackground}"
                 Foreground="{DynamicResource BrandWhite}" />
        <Button Grid.Row="2" Content="Close" Width="96" Height="36" Margin="0,12,0,0" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
