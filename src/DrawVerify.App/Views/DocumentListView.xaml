<UserControl x:Class="DrawVerify.App.Views.DocumentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8"><TextBlock Text="Documents" FontSize="24"/><TextBlock Text="{Binding SharingStatusMessage}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,4,0,4"/><DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" AutoGenerateColumns="False" IsReadOnly="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Select for sharing" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Document" Binding="{Binding DocumentName}" IsReadOnly="True"/><DataGridTextColumn Header="Viewer sharing" Binding="{Binding ViewerSharingStatus}" IsReadOnly="True"/></DataGrid.Columns></DataGrid><Button Content="Open selected document" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock Text="No items found" Margin="0,16,0,4" FontSize="18"/><TextBlock Text="Uploaded documents will appear here." Foreground="{DynamicResource BrandMuted}"/></StackPanel>
</UserControl>
