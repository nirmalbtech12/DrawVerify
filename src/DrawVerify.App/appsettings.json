{
  "Database": {
    "Path": "drawverify.db"
  },
  "StepUpload": {
    "MaxFileSizeMb": 50,
    "StorageFolder": "uploads/step",
    "DuplicatePolicy": "BlockAndConfirm",
    "ValidationTimeoutSeconds": 2
  },
  "DxfUpload": {
    "MaxFileSizeMb": 50,
    "StorageFolder": "uploads/dxf",
    "DuplicatePolicy": "BlockAndConfirm",
    "ValidationTimeoutSeconds": 2
  },
  "Authentication": {
    "PasswordMinimumLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "LockoutThreshold": 0,
    "LockoutDurationMinutes": 15,
    "DefaultRoles": []
  },
  "AuditLog": {
    "RetentionDays": 0
  },
  "Publish": {
    "Path": "C:\\Users\\nirma\\Documents\\Product\\DrawVerify\\Published"
  },
  "Logging": {
    "Level": "Information",
    "File": "logs/drawverify.log"
  },
  "WorkflowTemplates": {
    "Location": "config/workflow.default.json"
  },
  "DocumentTemplates": {
    "Location": "config/document-template.default.json"
  },
  "GdtSubset": {
    "Location": "config/gdt-subset.default.json"
  },
  "FingerprintPolicy": {
    "Location": "config/fingerprint-policy.default.json"
  },
  "MeasurementExtraction": {
    "MaximumFileSizeBytes": 52428800,
    "TimeoutSeconds": 30
  },
  "DxfDimensionExtraction": {
    "MaximumFileSizeBytes": 52428800,
    "TimeoutSeconds": 30
  },
  "DimensionMatching": {
    "MaximumStepFileSizeBytes": 52428800,
    "TimeoutSeconds": 60,
    "AbsoluteTolerance": 0.01,
    "ToleranceThresholdMm": 0.1,
    "AngularToleranceDegrees": 1.0,
    "ComparisonTimeoutSeconds": 30,
    "RelativeTolerance": 0.001,
    "HighConfidenceThreshold": 0.95,
    "MediumConfidenceThreshold": 0.75,
    "WorkerPath": "DrawVerify.OcctWorker.exe"
  }
}
