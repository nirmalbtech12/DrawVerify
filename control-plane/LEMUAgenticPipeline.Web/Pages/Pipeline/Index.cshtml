@page
@model PipelineIndexModel
@{
    ViewData["Title"] = "Pipeline Dashboard";
}
<h1>Pipeline Dashboard</h1>
<p>
  <a class="btn btn-primary" href="/Pipeline/Run">Run Pipeline</a>
  <a class="btn btn-secondary" href="/Pipeline/Runs">View All Runs</a>
</p>
<div class="row">
  <div class="col-md-2"><div class="card"><div class="card-body"><h5>Total</h5><p>@Model.Total</p></div></div></div>
  <div class="col-md-2"><div class="card"><div class="card-body"><h5>Running</h5><p>@Model.Running</p></div></div></div>
  <div class="col-md-2"><div class="card"><div class="card-body"><h5>Queued</h5><p>@Model.Queued</p></div></div></div>
  <div class="col-md-2"><div class="card"><div class="card-body"><h5>Completed</h5><p>@Model.Completed</p></div></div></div>
  <div class="col-md-2"><div class="card"><div class="card-body"><h5>Failed</h5><p>@Model.Failed</p></div></div></div>
  <div class="col-md-2"><div class="card"><div class="card-body"><h5>Waiting Approval</h5><p>@Model.Waiting</p></div></div></div>
</div>
<h3 class="mt-4">Recent Runs</h3>
<table class="table table-sm">
<thead><tr><th>Run ID</th><th>Jira ID</th><th>Schedule</th><th>Status</th><th>Current Agent</th><th>Started</th><th>Duration</th><th>Actions</th></tr></thead>
<tbody>
@foreach(var r in Model.Recent){
<tr>
<td><a href="/Pipeline/Runs/@r.RunId">@r.RunId</a></td>
<td>@r.JiraId</td>
<td>@r.ScheduleType</td>
<td><span class="badge bg-@(r.Status==Models.PipelineRunStatus.Completed?"success":r.Status==Models.PipelineRunStatus.Failed?"danger":r.Status==Models.PipelineRunStatus.Running?"primary":"secondary")">@r.Status</span></td>
<td>@r.CurrentAgent</td>
<td>@r.StartedAt?.ToLocalTime().ToString("g")</td>
<td>@(r.DurationSeconds?.ToString("0s") ?? "-")</td>
<td><a href="/Pipeline/Runs/@r.RunId">View</a></td>
</tr>
}
</tbody>
</table>
