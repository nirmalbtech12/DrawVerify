@page
@model RunsIndexModel
@{
    ViewData["Title"] = "Pipeline Runs";
}
<h1>Pipeline Runs</h1>
<form method="get" class="row g-2 mb-3">
  <div class="col"><input name="q" value="@Model.Q" placeholder="Jira ID (KAN-19)" class="form-control" /></div>
  <div class="col"><input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" /></div>
  <div class="col"><input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" /></div>
  <div class="col">
    <select name="status" class="form-select">
      <option value="">All Status</option>
      @foreach(var s in Enum.GetNames(typeof(Models.PipelineRunStatus))) {<option selected="@(Model.Status==s)">@s</option>}
    </select>
  </div>
  <div class="col"><button class="btn btn-primary">Search</button></div>
</form>
<table class="table table-sm">
<thead><tr><th>Run ID</th><th>Jira ID</th><th>Schedule</th><th>Status</th><th>Agents</th><th>Current</th><th>Started</th><th>Duration</th><th>Actions</th></tr></thead>
<tbody>
@foreach(var r in Model.Runs){
<tr>
<td><a href="/Pipeline/Runs/@r.RunId">@r.RunId</a></td>
<td>@r.JiraId</td>
<td>@r.ScheduleType @r.ScheduledAt?.ToLocalTime().ToString("g")</td>
<td>@r.Status</td>
<td>@(r.SelectedAgentsJson ?? "")</td>
<td>@r.CurrentAgent</td>
<td>@r.StartedAt?.ToLocalTime().ToString("g")</td>
<td>@(r.DurationSeconds?.ToString("0s") ?? "-")</td>
<td><a href="/Pipeline/Runs/@r.RunId">View</a></td>
</tr>
}
</tbody>
</table>
<nav>
  @if(Model.CurrentPage>1){<a href="?q=@Model.Q&status=@Model.Status&page=@(Model.CurrentPage-1)" class="btn btn-sm btn-outline-secondary">Prev</a>}
  <span>Page @Model.CurrentPage</span>
  <a href="?q=@Model.Q&status=@Model.Status&page=@(Model.CurrentPage+1)" class="btn btn-sm btn-outline-secondary">Next</a>
</nav>
