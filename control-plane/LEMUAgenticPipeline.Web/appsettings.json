{
  "ConnectionStrings": {
    "Pipeline": "Data Source=pipeline.db"
  },
  "Pipeline": {
    "Agents": {
      "Agents": [
        { "AgentId": "technical-design", "Name": "Technical Design", "Description": "Produces technical design", "Enabled": true, "ExecutionOrder": 1, "Dependencies": [], "RequiresHumanApproval": true },
        { "AgentId": "test-design", "Name": "Test Design", "Description": "Maps ACs to tests", "Enabled": true, "ExecutionOrder": 2, "Dependencies": ["technical-design"], "RequiresHumanApproval": true },
        { "AgentId": "implementation", "Name": "Implementation", "Description": "Implements approved designs", "Enabled": true, "ExecutionOrder": 3, "Dependencies": ["technical-design", "test-design"], "RequiresHumanApproval": false },
        { "AgentId": "test", "Name": "Test", "Description": "Runs dotnet build + test", "Enabled": true, "ExecutionOrder": 4, "Dependencies": ["implementation"], "RequiresHumanApproval": false },
        { "AgentId": "code-review", "Name": "Code Review", "Description": "Read-only review", "Enabled": true, "ExecutionOrder": 5, "Dependencies": ["test"], "RequiresHumanApproval": false },
        { "AgentId": "jira-update", "Name": "Jira Update", "Description": "Updates Jira + PR", "Enabled": true, "ExecutionOrder": 6, "Dependencies": ["code-review"], "RequiresHumanApproval": false }
      ],
      "DefaultSelected": ["technical-design"]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
